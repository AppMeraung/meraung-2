# Owner authentication (server-only)
MERAUNG_ADMIN_EMAIL=
# SHA-256 hex of the chosen password. Do not put the plaintext password here.
MERAUNG_ADMIN_PASSWORD_HASH=
# At least 32 random characters.
MERAUNG_SESSION_SECRET=

# Production must use `production`. Local preview requires `development`.
MERAUNG_RUNTIME=production
# Optional preview mode. It is ignored unless runtime is development and no
# production/VERCEL production marker exists.
MERAUNG_DEMO_MODE=false
# Optional local adapter testing. HTTP is still restricted to localhost.
MERAUNG_ALLOW_LOCAL_HTTP_METRICS=false

# Optional comma-separated allowlist for metrics adapter hosts.
MERAUNG_METRICS_ALLOWED_HOSTS=

# Repeat in GitHub order for each metrics key: MOTO, BARBER_PRO, BIZPOS,
# MYKIOSK, SKOLA, KENDURIKITA, EVENTSNAP2U, FONKITA and AFFILIXHQ.
MOTO_METRICS_URL=
MOTO_METRICS_TOKEN=
